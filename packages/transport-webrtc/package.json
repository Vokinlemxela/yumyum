{
  "name": "@yumyum-player/transport-webrtc",
  "version": "1.2.0",
  "description": "Low-latency WebRTC/WHEP transport for Yum-yum Player via WebRTC Encoded Transform.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@yumyum-player/core": "^1.2.0"
  },
  "devDependencies": {
    "@yumyum-player/core": "^1.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vokinlemxela/yumyum.git",
    "directory": "packages/transport-webrtc"
  },
  "homepage": "https://github.com/Vokinlemxela/yumyum/tree/main/packages/transport-webrtc#readme",
  "bugs": "https://github.com/Vokinlemxela/yumyum/issues",
  "publishConfig": {
    "access": "public"
  }
}
